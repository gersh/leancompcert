def wordAt (X : Nat) : UInt64 × UInt64 :=
  if X = 0 then (0, 0) else chunkWords[(X - 1) / 100]![(X - 1) % 100]!

def words10000 : Array (UInt64 × UInt64) :=
  (List.range 10001).toArray.map wordAt

def expected10000 : Array Cell := cellsOfWords words10000

theorem expected10000_lookup (C : Array (UInt64 × UInt64)) (X i : Nat)
    (hX : X < 10001) (hi : i < C.size)
    (hword : wordAt X = C[i]!) :
    expected10000[X]! = (cellsOfWords C)[i]! := by
  have hleft : X <
      (Array.map
        (fun p : UInt64 × UInt64 =>
          ({ lo := decodeZ p.1.toNat, hi := decodeZ p.2.toNat } : Cell))
        (Array.map wordAt (List.range 10001).toArray)).size := by
    simpa using hX
  have hright : i <
      (Array.map
        (fun p : UInt64 × UInt64 =>
          ({ lo := decodeZ p.1.toNat, hi := decodeZ p.2.toNat } : Cell))
        C).size := by
    simpa using hi
  simp only [expected10000, words10000, cellsOfWords]
  rw [getElem!_pos
        (Array.map
          (fun p : UInt64 × UInt64 =>
            ({ lo := decodeZ p.1.toNat, hi := decodeZ p.2.toNat } : Cell))
          (Array.map wordAt (List.range 10001).toArray))
        X hleft,
    getElem!_pos
        (Array.map
          (fun p : UInt64 × UInt64 =>
            ({ lo := decodeZ p.1.toNat, hi := decodeZ p.2.toNat } : Cell))
          C)
        i hright,
    Array.getElem_map, Array.getElem_map, List.getElem_toArray]
  have hword' : wordAt X = C[i] :=
    hword.trans (getElem!_pos C i hi)
  simp [hword']

theorem segment00 : hmTableSegment expected10000 0 100 =
    (10161763849799403122212, 725867740224877683) := by
  rw [hmTableSegment_eq_local expected10000 cells00 0 100]
  · exact total00
  · intro i hi
    change expected10000[0 + i + 1]! = (cellsOfWords words00)[i]!
    apply expected10000_lookup words00 (0 + i + 1) i
    · omega
    · simpa [words00] using hi
    · rw [wordAt]
      rw [show 0 + i + 1 - 1 = 0 + i by omega]
      have hdiv : (0 + i) / 100 = 0 := by omega
      have hmod : (0 + i) % 100 = i := by omega
      rw [hdiv, hmod]
      rfl

